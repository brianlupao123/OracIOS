# ═══════════════════════════════════════════════════════════════════════════════
# ORAC-IOS Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env and replace every placeholder locally.
# NEVER commit a real password, JWT secret, or hosted database URL.
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. Core Server ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5050

# ── 2. Storage ───────────────────────────────────────────────────────────────
# Production MUST be postgres. Local dev defaults to json.
STORE_DRIVER=postgres
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOSTNAME:5432/DATABASE?sslmode=require
# Local JSON fallback path (only used when STORE_DRIVER=json)
# JSON_DB_PATH=./data/db.json

# ── 3. Authentication & JWT ──────────────────────────────────────────────────
# Use a unique random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
# Production always requires a password. Set true on staging/UAT too.
ORAC_REQUIRE_PASSWORD=true

# ── 4. Google OAuth 2.0 SSO ──────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console. Unset = endpoint returns 503.
# GOOGLE_CLIENT_ID=
# Public website profile prefill. Use a different Google Web client from GOOGLE_CLIENT_ID.
# PUBLIC_GOOGLE_CLIENT_ID=
# PUBLIC_GOOGLE_ALLOWED_ORIGINS=https://public.example.com
# Include those same origins in CORS_ORIGINS for browser requests.

# ── 5. TOTP / Two-Factor ─────────────────────────────────────────────────────
# Off by default. Enrol and verify every protected user before enabling.
# Set the encryption key through the deployment secret manager, never this file.
# ORAC_TOTP_PROTECTED_ROLES=Admin,Management,Finance
# ORAC_TOTP_ENROLLMENT_ENABLED=true
# ORAC_TOTP_ENCRYPTION_KEY=<base64-encoded 32-byte secret>

# ── 6. Tax & Billing ─────────────────────────────────────────────────────────
# S-08: USD-only billing. Tax approval gate for production invoicing.
ORAC_REQUIRE_APPROVED_TAX=true

# ── 7. Network & Security ───────────────────────────────────────────────────
# Comma-separated portal origins, with no trailing slash.
CORS_ORIGINS=https://portal.example.com
# How many proxy hops sit in front of this service (Render/Fly = 1).
# Wrong value lets clients spoof req.ip for the rate limiter.
TRUST_PROXY_HOPS=1
# Never true in production (enforced by validateRuntimeConfig).
RATE_LIMIT_DISABLED=false

# ── 8. V5 Commercial Workflow (dark features) ───────────────────────────────
# V5 remains isolated and disabled until its separate release gates pass.
ORAC_V5_COMMERCIAL_WORKFLOW=disabled
ORAC_V5_INVOICE_WRITER=disabled

# ── 9. Timesheet Permission Overlays (dark) ─────────────────────────────────
# Each overlay is off until explicitly enabled. Production blocks SALES_ACCESS.
# TIMESHEET_SALES_ACCESS=disabled
# TIMESHEET_RATE_ROW_RESTRICT=disabled
# TIMESHEET_OPS_RESTRICT=disabled

# ── 10. Outbound Email Guard ────────────────────────────────────────────────
# Tripwire: must be explicitly enabled per deployment. No email without this.
# ORAC_OUTBOUND_EMAIL=disabled
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@orac.co.zw

# ── 11. Direct Sale Guard ───────────────────────────────────────────────────
# Tripwire: walk-in / direct-sale pathway is disabled until this is set.
# ORAC_DIRECT_SALE_ENABLED=disabled

# ── 12. Normalize DB Production Guard ───────────────────────────────────────
# Tripwire: prevent normalizeDb() from running in production with demo data.
# (Enforced in code — this is documentation only.)

# ── 13. PDF Generator ───────────────────────────────────────────────────────
# No external dependencies. Uses built-in pdf-lib only.
# PDF_ENCRYPTION_OWNER_PASSWORD=<random-32-chars>

# ── 14. Public Website Integration ──────────────────────────────────────────
# Rate limiting for unauthenticated public endpoints (enquiry, catalog).
# PUBLIC_RATE_LIMIT_WINDOW_MS=900000
# PUBLIC_RATE_LIMIT_MAX=50
